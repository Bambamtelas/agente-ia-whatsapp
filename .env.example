# Variáveis de ambiente - Atendimento IA WhatsApp
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env com valores reais

# ======================
# SUPABASE (Frontend)
# ======================
# Obtenha em: https://app.supabase.com -> Settings -> API
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# ======================
# VARIÁVEIS DE BACKEND
# Estas variáveis NÃO devem ter o prefixo VITE_
# pois NÃO devem ser expostas no frontend
# Configure no servidor/deploy separadamente
# ======================

# Evolution API (APENAS BACKEND)
EVOLUTION_API_URL=https://api.seudominio.com
EVOLUTION_API_KEY=sua-api-key-evolution

# Provedores de IA (APENAS BACKEND)
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIzaSy...
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...
